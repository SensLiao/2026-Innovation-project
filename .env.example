# SOMA — backend environment variables
# Copy to `.env` and fill in real values. NEVER commit a real .env.

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# In production, Claude is reached via AWS Bedrock with IAM instance-profile auth
# (no static key on the server).

# --- Database (PostgreSQL / Neon) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Segmentation models ---
# SAM-Med2D ONNX weights are downloaded separately (not committed).
# Set to "true" to skip loading the models at startup.
SKIP_MODELS=false

# --- Embeddings ---
# local = PubMedBERT FastAPI sidecar on LOCAL_EMBEDDING_URL; other options: voyage | mock
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_URL=http://127.0.0.1:8001
VOYAGE_API_KEY=

# --- Server ---
PORT=3000
